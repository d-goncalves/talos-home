# Per-node network and install patch, rendered from the [nodes] and [network]
# tables in provision.toml.
machine:
  network:
    # hostname is NOT set here: it comes from the kernel ip= argument in the
    # boot image. Setting it in both places makes Talos reject the config with
    # "static hostname is already set in v1alpha1 config".
    interfaces:
      - interface: ${interface}
        addresses:
          - ${ip}/${subnet_prefix}
        routes:
          - network: 0.0.0.0/0
            gateway: ${gateway}
        dhcp: false
    nameservers:
%{ for ns in nameservers ~}
      - ${ns}
%{ endfor ~}
  kubelet:
    nodeIP:
      # Without this kubelet picks whichever address it finds first, and with
      # the tailscale extension running that is the 100.64.0.0/10 tailnet
      # address. The node then registers with an InternalIP that is not on the
      # LAN, which breaks anything keyed on the real address.
      validSubnets:
        - ${lan_subnet}
  install:
    disk: ${install_disk}
    # Image Factory installer carrying the system extensions. System extensions
    # cannot be added to a running node, so this has to be correct at install
    # time.
    image: ${installer_image}
    wipe: false
