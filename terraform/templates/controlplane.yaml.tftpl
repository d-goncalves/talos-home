# Controlplane patch, with the tailnet domain templated from provision.toml.
#
# The CoreDNS rewrite is what lets Flux resolve the Gitea SSH host to the
# in-cluster LoadBalancer service instead of going out over the tailnet.
cluster:
  allowSchedulingOnControlPlanes: true
  controllerManager:
    extraArgs:
      # Kubernetes only garbage-collects terminated pods once this many exist,
      # and the default is 12500 — effectively never on a single-node cluster.
      # Every graceful shutdown (node reboot, scale to zero, eviction) leaves a
      # Succeeded pod behind, so `kubectl get pods -A` fills with corpses and
      # real failures get lost among pods that died months ago.
      terminated-pod-gc-threshold: "100"
  inlineManifests:
    - name: coredns-tailscale-rewrite
      contents: |
        apiVersion: v1
        kind: ConfigMap
        metadata:
          name: coredns
          namespace: kube-system
        data:
          Corefile: |
            .:53 {
                errors
                health {
                    lameduck 5s
                }
                ready
                log . {
                    class error
                }
                prometheus :9153
                rewrite name gitea-ssh.${tailnet_domain} gitea-ssh-tailscale.gitea.svc.cluster.local
                kubernetes cluster.local in-addr.arpa ip6.arpa {
                    pods insecure
                    fallthrough in-addr.arpa ip6.arpa
                    ttl 30
                }
                forward . /etc/resolv.conf {
                   max_concurrent 1000
                }
                cache 30 {
                   disable success cluster.local
                   disable denial cluster.local
                }
                loop
                reload
                loadbalance
            }
