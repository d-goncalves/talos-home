# Talos sensitive files — never commit these
talos/patches/tailscale.yaml
talos/patches/tailscale-ext.yaml
talos/talosconfig
talos/machine-config/
secrets/

# Local agent/editor tooling. .codex/config.toml holds MCP server credentials
# in plaintext — it must never be committed.
.codex/
.claude/

# Terraform. State holds the cluster PKI; the generated tfvars mirrors
# provision.toml and is rebuilt on every run.
talos/terraform/.talos/terraform/
talos/terraform/*.tfstate
talos/terraform/*.tfstate.*
talos/terraform/*.tfplan
talos/terraform/terraform.tfvars
talos/terraform/terraform.tfvars.json
talos/terraform/*.auto.tfvars

# Python
__pycache__/
*.egg-info/
.venv/
venv/

.DS_Store

# Agent instructions: kept on this machine, never published.
CLAUDE.md
AGENTS.md
