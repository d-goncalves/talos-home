# Talos sensitive files — never commit these
homelab/patches/tailscale.yaml
homelab/patches/tailscale-ext.yaml
homelab/talosconfig
homelab/machine-config/
secrets/

# Local agent/editor tooling. .codex/config.toml holds MCP server credentials
# in plaintext — it must never be committed.
.codex/
.claude/

# Terraform. Two roots, two states. homelab/ holds the cluster PKI and is
# backed up to 1Password; pihole/ holds only the tailnet nameserver list and is
# disposable. Each root also carries its own .gitignore — these entries are
# belt-and-braces so a state file cannot be committed from the repo root.
homelab/terraform/.terraform/
homelab/terraform/*.tfstate
homelab/terraform/*.tfstate.*
homelab/terraform/*.tfplan
homelab/terraform/terraform.tfvars
homelab/terraform/terraform.tfvars.json
homelab/terraform/*.auto.tfvars

pihole/terraform/.terraform/
pihole/terraform/*.tfstate
pihole/terraform/*.tfstate.*
pihole/terraform/*.tfplan
pihole/terraform/terraform.tfvars
pihole/terraform/terraform.tfvars.json
pihole/terraform/*.auto.tfvars

# Python
__pycache__/
*.egg-info/
.venv/
venv/

.DS_Store

# Agent instructions: kept on this machine, never published.
CLAUDE.md
AGENTS.md
